{
    "name": "jl1his-logger-desktop",
    "private": true,
    "version": "0.7.0",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "client": "pnpm --dir ../client run adif && pnpm --dir ../client run messages",
        "dev": "pnpm run client && vite dev",
        "build": "pnpm run client && vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "messages": "paraglide-js compile --project ./project.inlang --silent",
        "check": "pnpm run client && pnpm run messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "test": "pnpm run client && pnpm run messages && vitest --run",
        "tauri": "tauri"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "^2.29.3",
        "@inlang/plugin-message-format": "^4.5.5",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^22.20.5",
        "jl1his-logger-client": "link:../client",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "@fontsource-variable/geist": "5.3.0",
        "@fontsource-variable/m-plus-2": "5.3.1",
        "@tauri-apps/api": "^2.12.4"
    },
    "imports": {
        "#lib/*": "./src/lib/*",
        "#client/*": "jl1his-logger-client/src/lib/*"
    }
}
