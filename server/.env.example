# Address to listen on. Put a TLS-terminating reverse proxy in front of it:
# passkeys only work over HTTPS (or on http://localhost).
LISTEN=127.0.0.1:8080
# URL the app is reached at. Passkeys are bound to its host, so do not change it later.
PUBLIC_ORIGIN=https://log.example.com
# The built web app (cd client && pnpm run build). Without it only the API runs.
WEB_DIR=../client/build
# The one SQLite database (QSOs, stations, logbooks, users, passkeys, tokens).
# Migration snapshots go to the snapshots directory next to it.
DATABASE_PATH=./data/jl1his-logger.db
# TOML configuration (reference data paths, ADIF length unit); defaults apply without it.
# CONFIG_PATH=./config.toml
# Apply pending migrations when serve starts. Set to false to require the migrate subcommand.
AUTO_MIGRATE=true
