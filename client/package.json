{
    "name": "jl1his-logger-client",
    "private": true,
    "version": "0.5.4",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "wasm": "wasm-pack build ../query --target web --release --out-dir ../client/src/lib/query/wasm --out-name query --no-pack -- --features wasm",
        "vosk": "node scripts/vosk-worker.js",
        "messages": "paraglide-js compile --project ./project.inlang --silent",
        "adif": "node scripts/adif.js",
        "models": "bash scripts/setup-vosk.sh",
        "icons": "bash scripts/icons.sh",
        "dev": "pnpm run wasm && pnpm run adif && pnpm run vosk && vite dev",
        "build": "pnpm run wasm && pnpm run adif && pnpm run vosk && vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "pnpm run wasm && pnpm run adif && pnpm run messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "test": "pnpm run wasm && pnpm run adif && pnpm run messages && vitest --run"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "^2.29.2",
        "@inlang/plugin-message-format": "^4.5.5",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.20.5",
        "fake-indexeddb": "^6.2.6",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "@fontsource-variable/geist": "5.3.0",
        "@fontsource-variable/m-plus-2": "5.3.1",
        "@tabler/icons-svelte-runes": "^3.49.0",
        "bits-ui": "^2.20.2",
        "idb": "^8.0.4",
        "vosk-browser": "0.0.8"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    }
}
