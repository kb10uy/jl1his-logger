{
    "baseLocale": "en",
    "locales": ["en", "ja"],
    "modules": ["./node_modules/@inlang/plugin-message-format/dist/index.js"],
    "plugin.inlang.messageFormat": {
        "pathPattern": [
            "./messages/{locale}/common.json",
            "./messages/{locale}/errors.json",
            "./messages/{locale}/log.json",
            "./messages/{locale}/entry.json",
            "./messages/{locale}/voice.json",
            "./messages/{locale}/stations.json",
            "./messages/{locale}/transfer.json",
            "./messages/{locale}/settings.json",
            "./messages/{locale}/admin.json"
        ]
    }
}
