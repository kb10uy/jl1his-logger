    "log_marked_sent": [
        {
            "declarations": [
                "input count",
                "local countPlural = count: plural",
                "local n = count: number"
            ],
            "selectors": ["countPlural"],
            "match": {
                "countPlural=one": "Marked QSL sent on {n} QSO",
                "countPlural=other": "Marked QSL sent on {n} QSOs"
            }
        }
    ],
    "log_marked_received": [
        {
            "declarations": [
                "input count",
                "local countPlural = count: plural",
                "local n = count: number"
            ],
            "selectors": ["countPlural"],
            "match": {
                "countPlural=one": "Marked QSL received on {n} QSO",
                "countPlural=other": "Marked QSL received on {n} QSOs"
            }
        }
    ],
    "log_bulk_updated": [
        {
            "declarations": [
                "input count",
                "local countPlural = count: plural",
                "local n = count: number"
            ],
            "selectors": ["countPlural"],
            "match": {
                "countPlural=one": "Updated {n} QSO",
                "countPlural=other": "Updated {n} QSOs"
            }
        }
    ],
    "log_skipped_meanwhile": [
        {
            "declarations": ["input count", "local n = count: number"],
            "selectors": [],
            "match": { "": "; {n} skipped because they changed meanwhile" }
        }
    ],
    "log_undo": "Undo",
    "log_deleted": [
        {
            "declarations": [
                "input count",
